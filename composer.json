{
    "name": "wieslawgolec/plugin-smart-delay",
    "description": "Smart Delay (Send-Time Optimization) campaign action and A/B subject line block for Mautic 7+",
    "type": "mautic-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Wieslaw Golec"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/form": "^7.0",
        "symfony/options-resolver": "^7.0",
        "doctrine/dbal": "^3.0|^4.0"
    },
    "extra": {
        "mautic-plugin-name": "MauticSmartDelayBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticSmartDelayBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticSmartDelayBundle\\Tests\\": "tests/"
        },
        "files": [
            "tests/Stub/CampaignEvents.php",
            "tests/Stub/CampaignBuilderEvent.php",
            "tests/Stub/CampaignExecutionEvent.php",
            "tests/Stub/Lead.php",
            "tests/Stub/MauticCoreExtension.php",
            "tests/Stub/CoreEvents.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}
